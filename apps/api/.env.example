# Copie para .env (nunca commitar o .env). Valores abaixo são só exemplos.
NODE_ENV=development
PORT=3000

# Usuário restrito da API (só SELECT/INSERT/UPDATE/DELETE).
DATABASE_URL=postgres://passo_api:troque-esta-senha@localhost:5432/passo

# Origem do front (CORS, checagem de Origin e links dos e-mails).
FRONTEND_URL=http://localhost:5173

# 32+ caracteres aleatórios. Gere com: openssl rand -hex 32
SESSION_SECRET=

# Sem chave em desenvolvimento, os e-mails aparecem no console. Obrigatória em produção.
RESEND_API_KEY=
EMAIL_FROM=App de corrida <no-reply@letsgorun.devsaulo.com.br>
