# Copie para .env (nunca commitar o .env). Valores abaixo são só exemplos.
NODE_ENV=development
PORT=3000

# Usuário restrito da API (só SELECT/INSERT/UPDATE/DELETE).
DATABASE_URL=postgres://passo_api:troque-esta-senha@localhost:5432/passo

# Origem do front (CORS, checagem de Origin e links dos e-mails).
FRONTEND_URL=http://localhost:5173

# 32+ caracteres aleatórios. Gere com: openssl rand -hex 32
SESSION_SECRET=

# Sem chave em desenvolvimento, os e-mails aparecem no console. Obrigatória em produção.
RESEND_API_KEY=
EMAIL_FROM=Let's Go Run <no-reply@letsgorun.devsaulo.com.br>

# Lembrete do treino (Web Push). Gere o par com: pnpm --filter @passo/api exec web-push generate-vapid-keys
# Sem as duas chaves, o lembrete fica desligado (a tela de Configurações não oferece).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:no-reply@letsgorun.devsaulo.com.br
