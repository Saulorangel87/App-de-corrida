[Unit]
Description=Grava os logs da API do Let's Go Run em arquivo (sobrevivem ao deploy)
After=docker.service
Requires=docker.service

[Service]
User=ubuntu
# Cria /var/log/passo-api (dono ubuntu, sem acesso para outros).
LogsDirectory=passo-api
LogsDirectoryMode=0750
UMask=0027
ExecStart=/home/ubuntu/apps/app-de-corrida/api-logs.sh
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
